          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd trả về mô tả trống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 返回了空描述。"
          }
        }
      }
    },
    "launchd services" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd サービス"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 서비스"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ launchd"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 服务"
          }
        }
      }
    },
    "launchd stops the service, then starts it again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd がサービスを停止してから、再び開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 서비스를 중지한 후 다시 시작합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd sẽ dừng dịch vụ, rồi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 将停止该服务，然后再次启动。"
          }
        }
      }
    },
    "launchd stops the service. A service with KeepAlive may start again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd がサービスを停止します。KeepAlive が設定されたサービスは再び開始される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 서비스를 중지합니다. KeepAlive가 설정된 서비스는 다시 시작될 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd sẽ dừng dịch vụ. Dịch vụ có KeepAlive có thể tự khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 将停止该服务。设置了 KeepAlive 的服务可能会再次启动。"
          }
        }
      }
    },
    "launchd unloads the service from its domain until it is loaded again or the guest restarts." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd は、再び読み込まれるかゲストが再起動するまで、サービスをドメインから取り除きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 다시 불러오거나 게스트가 재시작될 때까지 해당 도메인에서 서비스를 내립니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd sẽ gỡ dịch vụ khỏi miền của nó cho đến khi được tải lại hoặc máy khách khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 将从其域中卸载该服务，直到再次载入或客户机重新启动。"
          }
        }
      }
    },
