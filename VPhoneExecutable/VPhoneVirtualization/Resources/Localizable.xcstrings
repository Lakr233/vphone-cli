    "launchd delivers the signal to the service's process." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd がサービスのプロセスにシグナルを送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 서비스 프로세스에 시그널을 전달합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd sẽ gửi tín hiệu đến tiến trình của dịch vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 将把该信号发送给服务的进程。"
          }
        }
      }
    },
    "launchd description of %arg" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "launchd description of %1$arg"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$arg の launchd 説明"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$arg의 launchd 설명"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô tả launchd của %1$arg"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$arg 的 launchd 描述"
          }
        }
      }
    },
    "launchd has not reported an exit." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd は終了を報告していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 종료를 보고하지 않았습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd chưa báo cáo lần thoát nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 尚未报告退出。"
          }
        }
      }
    },
    "launchd records a persistent override so the service does not load at the next boot. A running instance keeps running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd は永続的なオーバーライドを記録し、次回起動時にサービスを読み込まないようにします。実行中のインスタンスは実行を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 영구 재정의를 기록하여 다음 부팅 시 서비스를 불러오지 않습니다. 실행 중인 인스턴스는 계속 실행됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd sẽ ghi một thiết lập ghi đè lâu dài để dịch vụ không được tải ở lần khởi động tiếp theo. Phiên bản đang chạy vẫn tiếp tục chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 将记录一个持久覆盖设置，使该服务在下次启动时不再载入。正在运行的实例会继续运行。"
          }
        }
      }
    },
    "launchd reported no services." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd はサービスを報告しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd가 보고한 서비스가 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd không báo cáo dịch vụ nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd 未报告任何服务。"
          }
        }
      }
    },
    "launchd returned an empty description." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
