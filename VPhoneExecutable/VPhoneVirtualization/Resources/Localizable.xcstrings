    "Showing the first %arg accessibility elements. The guest stopped reading at its limit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing the first %1$arg accessibility elements. The guest stopped reading at its limit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の %1$arg 個のアクセシビリティ要素を表示しています。ゲストは上限に達したため読み込みを停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 %1$arg개의 손쉬운 사용 요소를 표시합니다. 게스트가 한도에 도달하여 읽기를 중단했습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị %1$arg phần tử trợ năng đầu tiên. Máy khách đã dừng đọc khi đạt giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示前 %1$arg 个辅助功能元素。客户机已达到读取上限。"
          }
        }
      }
    },
    "SIGCONT resumes a stopped process." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGCONT は停止中のプロセスを再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGCONT는 정지된 프로세스를 재개합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGCONT tiếp tục một tiến trình đang bị dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGCONT 会恢复已停止的进程。"
          }
        }
      }
    },
    "SIGHUP usually asks a daemon to reload or exit." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGHUP は通常、デーモンに再読み込みまたは終了を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGHUP은 보통 데몬에 다시 불러오기나 종료를 요청합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGHUP thường yêu cầu daemon tải lại hoặc thoát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGHUP 通常要求守护进程重新载入配置或退出。"
          }
        }
      }
    },
    "SIGINT interrupts the process, like Control-C in a terminal." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGINT はターミナルでの Control-C と同様にプロセスに割り込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGINT는 터미널의 Control-C처럼 프로세스를 인터럽트합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGINT ngắt tiến trình, giống như Control-C trong Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGINT 会中断进程，相当于在终端中按下 Control-C。"
          }
        }
      }
    },
    "SIGKILL ends the process immediately without cleanup. launchd may relaunch it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGKILL は後処理なしでプロセスを即座に終了します。launchd が再起動する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGKILL은 정리 과정 없이 프로세스를 즉시 종료합니다. launchd가 다시 실행할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGKILL kết thúc tiến trình ngay lập tức mà không dọn dẹp. launchd có thể khởi chạy lại tiến trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGKILL 会立即结束进程，不做任何清理。launchd 可能会重新启动它。"
          }
        }
      }
    },
