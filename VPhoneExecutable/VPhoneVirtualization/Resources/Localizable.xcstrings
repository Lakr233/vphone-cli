    "The guest agent is not connected. Wait for it to connect, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest agent is not connected. Wait for it to connect, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客体代理未连接。请等待连接后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストエージェントに接続されていません。接続を待ってから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 에이전트가 연결되지 않았습니다. 연결을 기다린 후 다시 시도하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác nhân máy khách chưa kết nối. Hãy chờ kết nối rồi thử lại."
          }
        }
      }
    },
    "The guest clipboard holds no text or image. Copy something in the guest, then refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest clipboard holds no text or image. Copy something in the guest, then refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客体剪贴板中没有文本或图像。请在客体中复制内容，然后刷新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストのクリップボードにテキストや画像がありません。ゲストで何かをコピーしてから更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 클립보드에 텍스트나 이미지가 없습니다. 게스트에서 무언가를 복사한 후 새로 고치세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng nhớ tạm của máy khách không có văn bản hay ảnh. Hãy sao chép nội dung trong máy khách rồi làm mới."
          }
        }
      }
    },
    "The guest did not respond. Check that the guest agent is connected, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest did not respond. Check that the guest agent is connected, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客体未响应。请检查客体代理连接后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストから応答がありません。ゲストエージェントの接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트가 응답하지 않았습니다. 게스트 에이전트 연결을 확인한 후 다시 시도하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy khách không phản hồi. Hãy kiểm tra kết nối của tác nhân máy khách rồi thử lại."
          }
        }
      }
    },
    "The guest is not connected. Start a VM, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest is not connected. Start a VM, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客体未连接。请启动虚拟机后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストに接続されていません。VM を起動して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트가 연결되지 않았습니다. VM을 시작한 후 다시 시도하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy khách chưa kết nối. Hãy khởi động máy ảo rồi thử lại."
