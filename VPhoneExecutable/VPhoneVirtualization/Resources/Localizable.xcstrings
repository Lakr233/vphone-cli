    "Choose Refresh to read the guest clipboard's text, image and types." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Refresh to read the guest clipboard's text, image and types."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「更新」を選択すると、ゲストのクリップボードのテキスト、画像、種類を読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 고침을 선택하여 게스트 클립보드의 텍스트, 이미지, 유형을 읽으세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Làm mới để đọc văn bản, ảnh và loại dữ liệu trong bảng nhớ tạm của máy khách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“刷新”以读取客体剪贴板的文本、图像和类型。"
          }
        }
      }
    },
