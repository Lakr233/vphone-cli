    "SIGSTOP suspends the process until it receives SIGCONT." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGSTOP は SIGCONT を受け取るまでプロセスを一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGSTOP은 SIGCONT를 받을 때까지 프로세스를 일시 정지합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGSTOP tạm dừng tiến trình cho đến khi nhận được SIGCONT."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGSTOP 会暂停进程，直到它收到 SIGCONT。"
          }
        }
      }
    },
    "SIGTERM asks the process to exit. launchd may relaunch it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGTERM はプロセスに終了を求めます。launchd が再起動する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGTERM은 프로세스에 종료를 요청합니다. launchd가 다시 실행할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGTERM yêu cầu tiến trình thoát. launchd có thể khởi chạy lại tiến trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIGTERM 会要求进程退出。launchd 可能会重新启动它。"
          }
        }
      }
    },
    "Size" : {
      "localizations" : {
        "en" : {
