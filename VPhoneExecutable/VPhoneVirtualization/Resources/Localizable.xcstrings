    "Exported %arg of %arg reports. Unable to export %arg. Check the connection, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exported %1$arg of %2$arg reports. Unable to export %3$arg. Check the connection, then try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$arg 件中 %1$arg 件のレポートを書き出しました。%3$arg を書き出せません。接続を確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서 %2$arg개 중 %1$arg개를 내보냈습니다. %3$arg을(를) 내보낼 수 없습니다. 연결을 확인한 다음 다시 시도하십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xuất %1$arg trên %2$arg báo cáo. Không thể xuất %3$arg. Hãy kiểm tra kết nối, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已导出 %2$arg 份报告中的 %1$arg 份。无法导出 %3$arg。请检查连接，然后重试。"
          }
        }
      }
    },
