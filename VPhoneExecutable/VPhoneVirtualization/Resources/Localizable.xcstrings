          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin %1$@ を %2$@ にインストールしました。\n\n一部のサービスを開始できませんでしたが、ブートストラップは使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irisin %1$@을(를) %2$@에 설치했습니다.\n\n일부 서비스를 시작하지 못했지만 부트스트랩은 사용할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cài Irisin %1$@ vào %2$@.\n\nMột số dịch vụ không khởi động được, nhưng bootstrap đã sẵn sàng để dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
