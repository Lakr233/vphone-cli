    "The app, its data container and its plug-ins' data are removed from the guest. This cannot be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ、そのデータコンテナ、およびプラグインのデータがゲストから削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱, 데이터 컨테이너 및 플러그인 데이터가 게스트에서 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng, vùng chứa dữ liệu và dữ liệu của các plug-in sẽ bị xóa khỏi máy khách. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从客户机中移除该应用、其数据容器及其插件的数据。此操作无法撤销。"
          }
        }
      }
    },
    "The binary has no entitlements." : {
