<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The general experimental groups `standard` leaves off: the
  Frida Stalker relaxations, the hv_vmm_present concealment, and the iPhone17,3
  identity rewrites. The HomePod-only top cap stays off.

  Read this as the catalogue and standard as the safe subset — the two name the
  same patch sets and differ only in their selection. Each patch's own version gate
  still applies, so the Frida patches land only on cloudOS 26.4 and newer.

  The hv_vmm_present pair is here and nowhere else for a reason: on a freshly
  restored 26.4 guest it is a brick. Renaming the OID makes bluetoothd's cached
  sysctl lookup fail, bluetoothd crash-loops, locationd blocks on its throttled
  XPC service, the data migrator never finishes and SpringBoard never draws.
  Choose this preset for VM-detection work on a guest that already booted, not to
  create one.
-->
<plist version="1.0">
<dict>
	<key>Identifier</key>
	<string>experimental</string>
	<key>Title</key>
	<string>Experimental</string>
	<key>Summary</key>
	<string>The experimental patches, including the Frida Stalker relaxations, the iPhone17,3 identity rewrites, and the hv_vmm_present concealment that a freshly restored 26.4 guest does not survive. The HomePod-only top cap is off.</string>
	<key>PatchSets</key>
	<array>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.bootchain</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.base</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.cfw</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.hypervisor</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.frida</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.research.board</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.devicetree</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.guest.system</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.guest.display</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.guest.identity</string>
		</dict>
	</array>
	<key>Selection</key>
	<dict>
		<key>Kind</key>
		<string>Block</string>
		<key>Patches</key>
		<array>
			<string>system-homeview-exp-setup_bypass</string>
			<string>system-homepod-exp-top_cap</string>
			<string>system-setupbackground-exp-pineboard_lookup</string>
			<string>system-setup-exp-deferred_focus</string>
			<string>system-mobileactivationd-exp-tv_activation</string>
			<string>system-tv-exp-legacy_setup</string>
			<string>system-homepod-exp-setup_bypass</string>
			<string>system-homepod-exp-welcome</string>
			<string>system-homepod-exp-siri_speech</string>
			<string>system-homepod-exp-ota_userland</string>
			<string>system-homepod-exp-sound_glow</string>
			<string>system-installd-exp-homepod_adhoc</string>
			<string>system-cryptexd-exp-homepod_staging</string>
			<string>preboot-homepod-exp-cryptex_class</string>
			<string>preboot-homepod-exp-audio_product</string>
		</array>
	</dict>
</dict>
</plist>
