    for (unsigned int vj = 0; vj < vpPN; vj++) [vpOut appendFormat:@"P %@ %s %s\n", vpCN, property_getName(vpPL[vj]), property_getAttributes(vpPL[vj])];
    free(vpPL);
    unsigned int vpIN = 0; Ivar *vpIL = class_copyIvarList(vpC, &vpIN);
    for (unsigned int vj = 0; vj < vpIN; vj++) [vpOut appendFormat:@"I %@ %s %s\n", vpCN, ivar_getName(vpIL[vj]), ivar_getTypeEncoding(vpIL[vj]) ?: ""];
    free(vpIL);
  }
}
