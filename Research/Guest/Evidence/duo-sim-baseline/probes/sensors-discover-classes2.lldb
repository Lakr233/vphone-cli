expr -l objc -O --
NSMutableString *vpOut = [NSMutableString string];
NSArray *vpNames = @[@"CMAngle", @"CMMagicPoseEvent", @"CMAngleManagerInternal", @"CMDeviceStateManagerInternal", @"SBFSyntheticCMAngle", @"SBFSyntheticMagicPoseEvent", @"SBFDevicePoseDefaults", @"SBFDevicePosePTSettings", @"UIHinge", @"_UISceneHingeState", @"_UISceneHingeStateHostComponent", @"_UISceneHingeStateSettings", @"_UISceneHingeStateClientSettings", @"SBHingeMotionUnintendedInteractionMonitor", @"PUIHingeState", @"SBFHingeSweep", @"UIHingeInteractionUpdate", @"_UIApplicationHingeStateWaiter", @"BKSAccelerometer"];
for (NSString *vpN in vpNames) {
  Class vpC = NSClassFromString(vpN);
  if (!vpC) { [vpOut appendFormat:@"=== %@: MISSING\n", vpN]; continue; }
  Dl_info vpInfo; dladdr((__bridge void *)vpC, &vpInfo);
  [vpOut appendFormat:@"=== %@ super=%@ image=%s\n", vpN, NSStringFromClass(class_getSuperclass(vpC)), vpInfo.dli_fname];
  for (int vk = 0; vk < 2; vk++) {
    Class vpT = vk ? object_getClass(vpC) : vpC;
    unsigned int vpCount = 0; Method *vpM = class_copyMethodList(vpT, &vpCount);
    for (unsigned int vj = 0; vj < vpCount; vj++) {
      [vpOut appendFormat:@"  %s%s %s\n", vk ? "+" : "-", sel_getName(method_getName(vpM[vj])), method_getTypeEncoding(vpM[vj])];
    }
    free(vpM);
  }
  unsigned int vpIC = 0; Ivar *vpIv = class_copyIvarList(vpC, &vpIC);
  for (unsigned int vj = 0; vj < vpIC; vj++) [vpOut appendFormat:@"  ivar %s %s\n", ivar_getName(vpIv[vj]), ivar_getTypeEncoding(vpIv[vj])];
  free(vpIv);
  unsigned int vpPC = 0; objc_property_t *vpPr = class_copyPropertyList(vpC, &vpPC);
  for (unsigned int vj = 0; vj < vpPC; vj++) [vpOut appendFormat:@"  prop %s %s\n", property_getName(vpPr[vj]), property_getAttributes(vpPr[vj])];
  free(vpPr);
}
vpOut

