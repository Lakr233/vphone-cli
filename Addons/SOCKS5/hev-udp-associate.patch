+/* A dual-stack Darwin socket may return AF_INET from recvmsg() but an
+ * IPv4-mapped AF_INET6 peer from getpeername(). Return the matching port in
+ * network byte order, or zero for a different sender. */
+static in_port_t
+hev_socks5_udp_peer_port (const struct sockaddr_in6 *peer,
+                          const struct msghdr *msg)
+{
+    const struct sockaddr *src = msg->msg_name;
+    if (msg->msg_namelen == sizeof (struct sockaddr_in) &&
+        src->sa_family == AF_INET && IN6_IS_ADDR_V4MAPPED (&peer->sin6_addr)) {
+        const struct sockaddr_in *v4 = msg->msg_name;
+        if (!memcmp (&v4->sin_addr, &peer->sin6_addr.s6_addr[12],
+                     sizeof (v4->sin_addr)))
+            return v4->sin_port;
+    } else if (msg->msg_namelen == sizeof (*peer) && src->sa_family == AF_INET6) {
+        const struct sockaddr_in6 *v6 = msg->msg_name;
+        if (IN6_ARE_ADDR_EQUAL (&v6->sin6_addr, &peer->sin6_addr) &&
+            v6->sin6_scope_id == peer->sin6_scope_id)
+            return v6->sin6_port;
+    }
+    return 0;
+}
