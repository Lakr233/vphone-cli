<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.network.client</key><true/>
    <!-- Replaced by scripts/build_camera_extension.sh from CAMERA_APP_GROUP.
         CMIO requires CMIOExtensionMachServiceName to be prefixed by this
         exact, provisioned macOS App Group. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>__VPHONE_CAMERA_APP_GROUP__</string>
    </array>
</dict>
</plist>
