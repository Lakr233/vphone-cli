{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Guest System" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Guest System"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のゲストシステム"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 게스트 시스템"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hệ thống máy khách của %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的客户机系统"
          }
        }
      }
    },
    "%@ allocated; the rest is shared with its template or clones." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ allocated; the rest is shared with its template or clones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "割り当て済み %@。残りはテンプレートまたは複製と共有しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 할당됨. 나머지는 템플릿 또는 복제본과 공유합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cấp phát %@; phần còn lại dùng chung với mẫu hoặc các bản nhân bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分配 %@；其余部分与模板或克隆共享。"
          }
        }
      }
    },
    "%@ are deleted from the IPSW cache." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ are deleted from the IPSW cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を IPSW キャッシュから削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) IPSW 캐시에서 삭제됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ bị xóa khỏi bộ nhớ đệm IPSW."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从 IPSW 缓存中删除 %@。"
          }
        }
      }
    },
    "%@ is not a language code such as ja or zh-Hant." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not a language code such as ja or zh-Hant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は ja や zh-Hant のような言語コードではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) ja 또는 zh-Hant 같은 언어 코드가 아닙니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không phải là mã ngôn ngữ như ja hoặc zh-Hant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 ja 或 zh-Hant 这样的语言代码。"
          }
        }
      }
    },
    "%@ keep working: they share its blocks but do not need it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ keep working: they share its blocks but do not need it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は引き続き動作します。ブロックを共有していますが、テンプレートは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 계속 동작합니다. 블록을 공유하지만 템플릿이 필요하지는 않습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vẫn hoạt động: chúng dùng chung khối dữ liệu nhưng không cần đến mẫu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 仍可正常使用：它们共享其数据块，但并不依赖它。"
          }
        }
      }
    },
    "%@ now runs with Core Bundle %@, but its guest environment was not updated. Update its guest environment to finish the change." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ now runs with Core Bundle %@, but its guest environment was not updated. Update its guest environment to finish the change."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はコアバンドル %2$@ で動作するようになりましたが、ゲスト環境は更新されていません。変更を完了するには、ゲスト環境を更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 이제 코어 번들 %2$@(으)로 실행되지만 게스트 환경은 업데이트되지 않았습니다. 변경을 마치려면 게스트 환경을 업데이트하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ giờ chạy bằng Bundle lõi %2$@, nhưng môi trường máy khách chưa được cập nhật. Hãy cập nhật môi trường máy khách để hoàn tất thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 现在使用核心 Bundle %2$@ 运行，但其客户机环境未更新。请更新客户机环境以完成更改。"
          }
        }
      }
    },
    "%lld could not be changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld could not be changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件は変更できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개는 변경할 수 없었습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể thay đổi %lld mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 项无法更改。"
          }
        }
      }
    },
    "%lld turned off, %lld turned back on." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld turned off, %lld turned back on."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 件をオフ、%2$lld 件をオンに戻しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld개 끔, %2$lld개 다시 켬."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tắt %1$lld, bật lại %2$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭 %1$lld 项，重新开启 %2$lld 项。"
          }
        }
      }
    },
    "A missing template is built in %@, set up once without a window, and saved under Templates." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A missing template is built in %@, set up once without a window, and saved under Templates."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートがなければ %@ で作成し、ウインドウなしで一度セットアップしてから「テンプレート」に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿이 없으면 %@에서 만들고 창 없이 한 번 설정한 뒤 템플릿에 저장합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu chưa có mẫu, mẫu sẽ được dựng trong %@, thiết lập một lần không có cửa sổ và lưu vào Mẫu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有模板，会在 %@ 中构建模板，无界面完成一次设置，然后保存到“模板”中。"
          }
        }
      }
    },
    "A template build stopped before it finished: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A template build stopped before it finished: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートの作成が途中で止まりました: %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿 빌드가 완료되기 전에 중단됨: %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bản dựng mẫu đã dừng trước khi xong: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个模板构建未完成就停止了：%@"
          }
        }
      }
    },
    "A template never keeps them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A template never keeps them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートには残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿에는 보관되지 않습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mẫu không bao giờ giữ lại chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板从不保留它们。"
          }
        }
      }
    },
    "Allocated" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allocated"
          }
        },
        "ja" : {
