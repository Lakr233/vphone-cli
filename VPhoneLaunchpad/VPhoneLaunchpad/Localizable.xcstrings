    "Traffic leaves through this Mac's own connections, so it follows the Mac's VPN." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traffic leaves through this Mac's own connections, so it follows the Mac's VPN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信はこの Mac 自身の接続から送られるため、Mac の VPN を経由します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트래픽이 이 Mac의 자체 연결로 나가므로 Mac의 VPN을 따릅니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu lượng đi qua các kết nối của chính máy Mac này, nên sẽ đi theo VPN của máy Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流量从这台 Mac 自己的连接发出，因此会经过 Mac 的 VPN。"
          }
        }
      }
    },
    "NAT Network" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "NAT Network" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "NAT ネットワーク" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "NAT 네트워크" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mạng NAT" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "NAT 网络" } }
      }
    },
    "The Mac’s DHCP server keeps an address for every guest MAC it has seen, even after the lease runs out. Release frees the addresses of iOS guests no machine uses any more, such as deleted machines. It needs an administrator." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac’s DHCP server keeps an address for every guest MAC it has seen, even after the lease runs out. Release frees the addresses of iOS guests no machine uses any more, such as deleted machines. It needs an administrator." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mac の DHCP サーバーは、一度見たゲストの MAC ごとにアドレスを確保し、リースが切れても手放しません。「解放」は、削除したマシンなど、どのマシンも使っていない iOS ゲストのアドレスを解放します。管理者の承認が必要です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Mac의 DHCP 서버는 한 번 본 게스트 MAC마다 주소를 잡아 두며, 임대가 만료된 뒤에도 놓지 않습니다. 해제는 삭제한 머신처럼 더 이상 어떤 머신도 쓰지 않는 iOS 게스트의 주소를 풀어 줍니다. 관리자 승인이 필요합니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Máy chủ DHCP của Mac giữ một địa chỉ cho mỗi MAC máy khách từng thấy, kể cả khi hợp đồng thuê đã hết hạn. Giải phóng sẽ thu hồi địa chỉ của các máy khách iOS không còn máy nào dùng, chẳng hạn máy đã xoá. Cần quyền quản trị viên." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 的 DHCP 服务器会为见过的每个客户机 MAC 保留一个地址，租约到期后也不放手。“释放”会收回已经没有机器使用的 iOS 客户机的地址，例如已删除的机器。需要管理员权限。" } }
      }
    },
    "Addresses held by old guests" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Addresses held by old guests" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "古いゲストが保持しているアドレス" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이전 게스트가 점유한 주소" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Địa chỉ do máy khách cũ giữ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "旧客户机占用的地址" } }
      }
    },
    "Release…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Release…" } },
