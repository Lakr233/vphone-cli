    "After allowing vphone-launchpad under Privacy & Security → Developer Tools, quit and reopen it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After allowing vphone-launchpad under Privacy & Security → Developer Tools, quit and reopen it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「プライバシーとセキュリティ」→「デベロッパツール」で vphone-launchpad を許可したあと、終了してから開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호 및 보안 → 개발자 도구에서 vphone-launchpad를 허용한 후 종료했다가 다시 여십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi cho phép vphone-launchpad trong Quyền riêng tư & Bảo mật → Công cụ dành cho nhà phát triển, hãy thoát rồi mở lại ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“隐私与安全性”→“开发者工具”中允许 vphone-launchpad 后，请退出并重新打开它。"
          }
        }
      }
    },
    "Allow vphone-launchpad in Privacy & Security → Developer Tools, then click Reopen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow vphone-launchpad in Privacy & Security → Developer Tools, then click Reopen."
