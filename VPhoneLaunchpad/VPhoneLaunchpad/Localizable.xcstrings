        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「プライバシーとセキュリティ」→「デベロッパツール」で vphone-launchpad を許可してから、「開き直す」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호 및 보안 → 개발자 도구에서 vphone-launchpad를 허용한 후 다시 열기를 클릭하십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho phép vphone-launchpad trong Quyền riêng tư & Bảo mật → Công cụ dành cho nhà phát triển, rồi bấm Mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“隐私与安全性”→“开发者工具”中允许 vphone-launchpad，然后点按“重新打开”。"
