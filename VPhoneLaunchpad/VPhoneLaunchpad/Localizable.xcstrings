    "Quitting stops creating this machine. You can retry later from the step where it stopped." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitting stops creating this machine. You can retry later from the step where it stopped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了すると、このマシンの作成が停止します。あとで停止したステップから再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료하면 이 머신의 생성이 중지됩니다. 나중에 중지된 단계부터 다시 시도할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát sẽ dừng việc tạo máy ảo này. Bạn có thể thử lại sau từ bước đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出会停止创建此虚拟机。你可以稍后从停止的步骤重试。"
          }
        }
      }
    },
    "Quitting stops the New Machine pipeline. You can retry it later from the step it stopped at." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitting stops the New Machine pipeline. You can retry it later from the step it stopped at."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了すると新規マシンの作成処理が停止します。あとで停止したステップから再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료하면 새로운 머신 생성 과정이 중지됩니다. 나중에 중지된 단계부터 다시 시도할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát sẽ dừng quy trình tạo máy ảo mới. Bạn có thể thử lại sau từ bước đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出会停止新建虚拟机流程。你可以稍后从中断的步骤重试。"
