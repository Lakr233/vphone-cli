    "The machine's disk, firmware and settings are removed. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The machine's disk, firmware and settings are removed. This cannot be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンのディスク、ファームウェア、設定が削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머신의 디스크, 펌웨어 및 설정이 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổ đĩa, firmware và cài đặt của máy ảo sẽ bị xóa. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机的磁盘、固件和设置都将被移除。此操作无法撤销。"
          }
        }
      }
    },
    "The path is too long. Use a shorter name, or a location with a shorter path." : {
      "localizations" : {
