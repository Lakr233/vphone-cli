    },
    "The installed helper did not match the copy in this app. Try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed helper did not match the copy in this app. Try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールされたヘルパーがこの App 内のコピーと一致しませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 도우미가 이 앱에 포함된 사본과 일치하지 않습니다. 다시 시도하십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình trợ giúp đã cài không khớp với bản trong ứng dụng này. Hãy thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的 Helper 与此应用中的副本不一致。请重试。"
          }
        }
      }
    },
    "The machine did not enter DFU mode within 30 seconds." : {
