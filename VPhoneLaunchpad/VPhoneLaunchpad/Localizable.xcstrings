    "The helper did not answer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The helper did not answer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーが応答しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도우미가 응답하지 않았습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình trợ giúp không phản hồi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helper 没有响应。"
          }
        }
      }
    },
    "The install keeps running. Core Bundle shows it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The install keeps running. Core Bundle shows it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールは続行されます。コアバンドルから再度表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치는 계속 진행됩니다. 코어 번들에서 다시 볼 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
