    },
    "VPhone.bundle %@ did not pass host preflight." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ did not pass host preflight." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ はホストの事前チェックに合格しませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@이(가) 호스트 사전 검사를 통과하지 못했습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ không vượt qua kiểm tra máy chủ." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ 未通过主机预检。" } }
      }
    },
    "VPhone.bundle %@ is not installed." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ is not installed." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ はインストールされていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@이(가) 설치되어 있지 않습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ chưa được cài đặt." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ 未安装。" } }
      }
    },
    "VPhone.bundle %@ is not installed. Choose Change Core Bundle… to run this machine with another version." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ is not installed. Choose Change Core Bundle… to run this machine with another version." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ はインストールされていません。「コアバンドルを変更…」を選択して、このマシンを別のバージョンで実行してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@이(가) 설치되어 있지 않습니다. 코어 번들 변경…을 선택해 이 머신을 다른 버전으로 실행하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ chưa được cài đặt. Chọn Đổi Bundle lõi… để chạy máy này với phiên bản khác." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "VPhone.bundle %@ 未安装。请选择“更改核心 Bundle…”，用其他版本运行这台机器。" } }
      }
    },
    "vphone-cli and vphone-vm come from this bundle at every start." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "vphone-cli and vphone-vm come from this bundle at every start." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "vphone-cli と vphone-vm は起動のたびにこのバンドルから読み込まれます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "vphone-cli와 vphone-vm은 시작할 때마다 이 번들에서 실행됩니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "vphone-cli và vphone-vm được lấy từ bundle này mỗi lần khởi động." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次启动时都使用此 Bundle 中的 vphone-cli 和 vphone-vm。" } }
      }
    },
    "vphoned and the hook libraries in the guest." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "vphoned and the hook libraries in the guest." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲスト内の vphoned とフックライブラリ。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트의 vphoned와 후크 라이브러리." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "vphoned và các thư viện hook trong máy khách." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客户机中的 vphoned 和 hook 库。" } }
      }
    },
    "New device identity" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New device identity" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいデバイス ID" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 기기 식별 정보" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Danh tính thiết bị mới" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新的设备身份" } }
      }
    },
    "The clone gets its own ECID, UDID and MAC address, so it can run alongside the original. The guest asks to trust this Mac again the first time it connects." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The clone gets its own ECID, UDID and MAC address, so it can run alongside the original. The guest asks to trust this Mac again the first time it connects." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "複製には独自の ECID、UDID、MAC アドレスが割り当てられるため、元のマシンと同時に実行できます。初めて接続するとき、ゲストはこの Mac を信頼するかどうかを再度確認します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "복제본은 고유한 ECID, UDID 및 MAC 주소를 받으므로 원본과 함께 실행할 수 있습니다. 처음 연결할 때 게스트가 이 Mac을 신뢰할지 다시 묻습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao nhận ECID, UDID và địa chỉ MAC riêng nên có thể chạy cùng lúc với máy gốc. Ở lần kết nối đầu tiên, máy khách sẽ hỏi lại có tin cậy máy Mac này không." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "克隆会获得自己的 ECID、UDID 和 MAC 地址，因此可以与原虚拟机同时运行。首次连接时，客户机会再次询问是否信任这台 Mac。" } }
      }
    },
    "The clone is the same device as the original. Run only one of them at a time." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The clone is the same device as the original. Run only one of them at a time." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "複製は元のマシンと同じデバイスです。同時に実行できるのはどちらか一方だけです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "복제본은 원본과 같은 기기입니다. 한 번에 하나만 실행하십시오." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao là cùng một thiết bị với máy gốc. Mỗi lúc chỉ chạy một trong hai máy." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "克隆与原虚拟机是同一台设备。两者同一时间只能运行一个。" } }
      }
    },
    "Snapshots…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Snapshots…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショット…" } },
