    "^[%lld boot chain patch](inflect: true) that only a restore applies" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "^[%lld boot chain patch](inflect: true) that only a restore applies" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元でのみ反映される起動チェーンのパッチ：%lld 件" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "복원으로만 반영되는 부트 체인 패치 %lld개" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld bản vá chuỗi khởi động chỉ áp dụng khi khôi phục" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个启动链补丁只有重新恢复才会生效" } }
