    "About 140 launch daemons a research machine rarely needs, Apple Account's among them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About 140 launch daemons a research machine rarely needs, Apple Account's among them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "研究用マシンではほとんど使わない約 140 の launch デーモンで、Apple アカウント関連のものも含みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연구용 머신에 거의 필요 없는 약 140개의 launch 데몬이며, Apple 계정 관련 데몬도 포함됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
