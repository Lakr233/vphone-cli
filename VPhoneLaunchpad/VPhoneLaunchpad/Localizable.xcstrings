    "Its restored disk is deleted. A machine that needs this template builds it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its restored disk is deleted. A machine that needs this template builds it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元済みのディスクを削除します。このテンプレートが必要なマシンは、もう一度作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원된 디스크가 삭제됩니다. 이 템플릿이 필요한 머신은 다시 빌드합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổ đĩa đã khôi phục sẽ bị xóa. Máy ảo nào cần mẫu này sẽ dựng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除已恢复的磁盘。需要此模板的虚拟机会重新构建它。"
          }
        }
      }
    },
