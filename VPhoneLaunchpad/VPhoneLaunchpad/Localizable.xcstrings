    "^[%lld patch](inflect: true)" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "^[%lld patch](inflect: true)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 件のパッチ" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "패치 %lld개" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld bản vá" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个补丁" } }
      }
    },
    "The guest has every patch this machine is set to." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The guest has every patch this machine is set to." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンに設定したパッチはすべてゲストに適用されています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신에 설정한 패치가 모두 게스트에 적용되어 있습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Máy khách đã có mọi bản vá được đặt cho máy này." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客户机已包含为此虚拟机设定的全部补丁。" } }
      }
    },
    "Boot chain: ^[%lld patch](inflect: true) (TXM, device tree, LLB) not applied; only a restore applies them, which erases the data. Run `vphone-cli fw patches %@` for each." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Boot chain: ^[%lld patch](inflect: true) (TXM, device tree, LLB) not applied; only a restore applies them, which erases the data. Run `vphone-cli fw patches %@` for each." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "起動チェーン：未反映 %lld 件（TXM・デバイスツリー・LLB）。復元でのみ反映され、復元するとデータは消去されます。各手順は `vphone-cli fw patches %@` で確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "부트 체인: 미반영 %lld개(TXM, 디바이스 트리, LLB). 복원으로만 반영되며 복원하면 데이터가 지워집니다. 각 단계는 `vphone-cli fw patches %@`로 확인하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chuỗi khởi động: %lld bản vá (TXM, cây thiết bị, LLB) chưa áp dụng; chỉ khôi phục mới áp dụng, việc này xoá dữ liệu. Chạy `vphone-cli fw patches %@` để xem từng bước." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动链：%lld 个补丁（TXM、设备树、LLB）未应用；只有重新恢复才会生效，而恢复会清除数据。运行 `vphone-cli fw patches %@` 查看各自步骤。" } }
      }
    },
    "Update Kernel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update Kernel" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "カーネルを更新" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "커널 업데이트" } },
