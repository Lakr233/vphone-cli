      }
    },
    "Release %lld Addresses?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Release %lld Addresses?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 個のアドレスを解放しますか?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "주소 %lld개를 해제하시겠습니까?" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giải phóng %lld địa chỉ?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "释放 %lld 个地址？" } }
      }
    },
    "Release" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Release" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "解放" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "해제" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giải phóng" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "释放" } }
      }
    },
    "Their leases have run out and no machine in your libraries has their MAC. A guest that comes back with one of these MACs gets a new address." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Their leases have run out and no machine in your libraries has their MAC. A guest that comes back with one of these MACs gets a new address." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらのリースは期限切れで、ライブラリのどのマシンもその MAC を使っていません。これらの MAC で戻ってきたゲストには新しいアドレスが割り当てられます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 임대는 만료되었고 라이브러리의 어떤 머신도 해당 MAC을 쓰지 않습니다. 이 MAC으로 다시 나타나는 게스트는 새 주소를 받습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các hợp đồng thuê này đã hết hạn và không máy nào trong thư viện dùng MAC của chúng. Máy khách quay lại với một trong các MAC này sẽ nhận địa chỉ mới." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些租约已经到期，资料库中也没有机器使用对应的 MAC。之后若有客户机以这些 MAC 回来，会分配到新地址。" } }
      }
    },
    "%lld addresses no machine uses" : {
