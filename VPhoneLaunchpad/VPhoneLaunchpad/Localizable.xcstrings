      }
    },
    "Unable to update the kernel." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to update the kernel." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "カーネルを更新できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "커널을 업데이트할 수 없습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể cập nhật kernel." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法更新内核。" } }
      }
    },
    "The disk of %@ is open in process %@, which does not run it. Try again once that process closes it." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk of %@ is open in process %@, which does not run it. Try again once that process closes it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ のディスクはプロセス %2$@ が開いていますが、このプロセスはマシンを実行していません。そのプロセスがディスクを閉じてから、もう一度お試しください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%1$@의 디스크를 프로세스 %2$@이(가) 열고 있지만, 이 프로세스는 머신을 실행하지 않습니다. 해당 프로세스가 디스크를 닫은 후 다시 시도하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đĩa của %1$@ đang được mở bởi tiến trình %2$@, tiến trình này không chạy máy. Hãy thử lại sau khi tiến trình đó đóng đĩa." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ 的磁盘正被进程 %2$@ 打开，该进程并未运行这台机器。请等该进程关闭磁盘后再试。" } }
      }
    },
    "Swaps the Preboot kernelcache for the one this machine's patches resolve to, keeping the data (no restore)." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Swaps the Preboot kernelcache for the one this machine's patches resolve to, keeping the data (no restore)." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Preboot のカーネルキャッシュをこのマシンのパッチ選択に合うものに入れ替えます。データは保持され、復元は不要です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Preboot 커널 캐시를 이 머신의 패치 선택에 맞는 것으로 교체합니다. 데이터는 유지되며 복원이 필요 없습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thay kernelcache trong Preboot bằng bản khớp với lựa chọn bản vá của máy này, giữ nguyên dữ liệu (không khôi phục)." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把 Preboot 的内核缓存换成与此虚拟机补丁选择匹配的版本，保留数据（无需恢复）。" } }
      }
    },
    "Stop the machine to update its kernel." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop the machine to update its kernel." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "カーネルを更新するにはマシンを停止してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "커널을 업데이트하려면 머신을 중지하십시오." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy dừng máy để cập nhật kernel." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止虚拟机后才能更新其内核。" } }
      }
    },
    "^[%lld kernel patch](inflect: true) to apply with Update Kernel (keeps the data)." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "^[%lld kernel patch](inflect: true) to apply with Update Kernel (keeps the data)." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「カーネルを更新」で反映するカーネルのパッチ：%lld 件（データは保持）。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘커널 업데이트’로 반영할 커널 패치 %lld개(데이터 유지)." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld bản vá kernel sẽ áp dụng bằng Cập nhật kernel (giữ dữ liệu)." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个内核补丁可用“更新内核”生效（保留数据）。" } }
      }
    },
    "Apply to Guest" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Apply to Guest" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲストに適用" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트에 적용" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Áp dụng cho máy khách" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用到客户机" } }
      }
    },
    "Updates the guest environment, which turns guest patches on or off to match this machine’s choice." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates the guest environment, which turns guest patches on or off to match this machine’s choice." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲスト環境を更新し、このマシンの選択に合わせてゲストのパッチをオン／オフします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트 환경을 업데이트하여 이 머신의 선택에 맞게 게스트 패치를 켜거나 끕니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cập nhật môi trường máy khách, bật hoặc tắt các bản vá máy khách cho khớp với lựa chọn của máy này." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新客户机环境，按此虚拟机的选择打开或关闭客户机补丁。" } }
      }
    },
    "Stop the machine to apply its patch choice to the guest." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop the machine to apply its patch choice to the guest." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "パッチの選択をゲストに適用するには、マシンを停止してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "패치 선택을 게스트에 적용하려면 머신을 중지하십시오." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy dừng máy để áp dụng lựa chọn bản vá cho máy khách." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止虚拟机后才能把补丁选择应用到客户机。" } }
      }
    },
    "^[%lld guest patch](inflect: true) to apply with Apply to Guest." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "^[%lld guest patch](inflect: true) to apply with Apply to Guest." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「ゲストに適用」で反映するゲストのパッチ：%lld 件。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘게스트에 적용’으로 반영할 게스트 패치 %lld개." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld bản vá máy khách sẽ được áp dụng bằng “Áp dụng cho máy khách”." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个客户机补丁可用“应用到客户机”生效。" } }
      }
    },
    "^[%lld boot chain patch](inflect: true) that only a restore applies." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "^[%lld boot chain patch](inflect: true) that only a restore applies." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元でのみ反映される起動チェーンのパッチ：%lld 件。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "복원으로만 반영되는 부트 체인 패치 %lld개." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld bản vá chuỗi khởi động chỉ được áp dụng khi khôi phục." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个启动链补丁只有重新恢复才会生效。" } }
      }
    },
    "vphone-cli fw patches %@ lists each one." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "vphone-cli fw patches %@ lists each one." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "各パッチは vphone-cli fw patches %@ で確認できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "각 패치는 vphone-cli fw patches %@ 로 확인할 수 있습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "vphone-cli fw patches %@ liệt kê từng bản vá." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行 vphone-cli fw patches %@ 可逐个查看。" } }
      }
    },
    "No change" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No change" } },
