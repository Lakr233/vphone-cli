        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンでは CFW インストールまたはゲスト環境の更新がすでに実行中です。完了するまで待ってから、もう一度お試しください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신에서 CFW 설치 또는 게스트 환경 업데이트가 이미 진행 중입니다. 완료될 때까지 기다린 후 다시 시도하십시오." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Máy này đang chạy một lần cài CFW hoặc cập nhật môi trường máy khách. Hãy đợi nó xong rồi thử lại." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台机器上已有 CFW 安装或客户机环境更新正在进行。请等它完成后再试。" } }
      }
    },
