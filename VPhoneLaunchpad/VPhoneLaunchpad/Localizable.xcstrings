        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트 환경 업데이트로 반영할 게스트 패치 %lld개" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld bản vá máy khách sẽ áp dụng khi cập nhật môi trường máy khách" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个客户机补丁在更新客户机环境时生效" } }
