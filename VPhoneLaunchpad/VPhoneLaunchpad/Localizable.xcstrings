            "value" : "命令失败。"
          }
        }
      }
    },
    "The DFU boot did not write udid-prediction.txt within 30 seconds." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The DFU boot did not write udid-prediction.txt within 30 seconds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFU 起動が 30 秒以内に udid-prediction.txt を書き込みませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFU 부팅이 30초 이내에 udid-prediction.txt를 기록하지 않았습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần khởi động DFU không ghi udid-prediction.txt trong vòng 30 giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFU 启动未在 30 秒内写入 udid-prediction.txt。"
