    "Stored in %@ and managed by the helper." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored in %@ and managed by the helper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に保存され、特権ヘルパーが管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 저장되며 권한 있는 도우미가 관리합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được lưu trong %@ và do trình trợ giúp đặc quyền quản lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存放在 %@，由特权 Helper 管理。"
          }
        }
      }
    },
    "Stored in %@, owned by root and written only by the helper." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored in %@, owned by root and written only by the helper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に保存されます。所有者は root で、ヘルパーのみが書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 저장되며, root가 소유하고 도우미만 기록합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được lưu trong %@, thuộc sở hữu của root và chỉ trình trợ giúp được ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储在 %@ 中，所有者为 root，仅由 Helper 写入。"
          }
        }
      }
    },
    "The download could not be verified. Try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download could not be verified. Try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードを検証できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
