    "Unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unavailable" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用できません" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용할 수 없음" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không khả dụng" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不可用" } }
      }
    },
    "Guest Environment" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Guest Environment" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲスト環境" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트 환경" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Môi trường máy khách" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客户机环境" } }
      }
    },
    "Host Programs" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Host Programs" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストプログラム" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 프로그램" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chương trình máy chủ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机程序" } }
      }
    },
    "Host programs change at the next start. The guest environment is updated now on stopped machines; running machines keep theirs until it is updated later. Guest patches follow each machine’s patch choice when its guest environment is updated. The boot chain stays as it was built." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Host programs change at the next start. The guest environment is updated now on stopped machines; running machines keep theirs until it is updated later. Guest patches follow each machine’s patch choice when its guest environment is updated. The boot chain stays as it was built." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストプログラムは次回の起動時に切り替わります。停止中のマシンではゲスト環境を今すぐ更新します。実行中のマシンは、後で更新するまで現在のゲスト環境のままです。ゲストのパッチは、ゲスト環境の更新時に各マシンのパッチ選択に従います。ブートチェーンは構築時のままです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 프로그램은 다음 시작부터 바뀝니다. 정지된 머신은 게스트 환경을 지금 업데이트하고, 실행 중인 머신은 나중에 업데이트할 때까지 기존 환경을 유지합니다. 게스트 패치는 게스트 환경을 업데이트할 때 각 머신의 패치 선택을 따릅니다. 부트 체인은 빌드된 그대로 유지됩니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chương trình máy chủ sẽ thay đổi từ lần khởi động tiếp theo. Môi trường máy khách được cập nhật ngay trên các máy đang dừng; máy đang chạy giữ môi trường hiện tại cho đến khi được cập nhật sau. Các bản vá máy khách theo lựa chọn bản vá của từng máy khi môi trường máy khách được cập nhật. Chuỗi khởi động giữ nguyên như khi được dựng." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机程序在下次启动时切换。已停止的机器会立即更新客户机环境；正在运行的机器保留原有环境，直到之后再更新。客户机补丁在更新客户机环境时按各机器的补丁选择应用。启动链保持构建时的状态。" } }
      }
    },
    "Install it in Core Bundle, or choose another version for this machine." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Install it in Core Bundle, or choose another version for this machine." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「コアバンドル」でインストールするか、このマシンに別のバージョンを選択してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "코어 번들에서 설치하거나 이 머신에 다른 버전을 선택하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy cài đặt trong Bundle lõi, hoặc chọn phiên bản khác cho máy này." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在“核心 Bundle”中安装，或为这台机器选择其他版本。" } }
      }
    },
    "Local build %@ · Installed %@ · SHA-256 %@" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Local build %@ · Installed %@ · SHA-256 %@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルビルド %1$@ · インストール日 %2$@ · SHA-256 %3$@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로컬 빌드 %1$@ · 설치 %2$@ · SHA-256 %3$@" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản dựng cục bộ %1$@ · Cài đặt %2$@ · SHA-256 %3$@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地构建 %1$@ · 安装于 %2$@ · SHA-256 %3$@" } }
      }
    },
    "New machines use the default version. Each machine keeps its own Core Bundle, which you change from the machine list." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New machines use the default version. Each machine keeps its own Core Bundle, which you change from the machine list." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマシンはデフォルトのバージョンを使います。各マシンは自分のコアバンドルを保持し、マシン一覧から変更できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 머신은 기본 버전을 사용합니다. 각 머신은 자체 코어 번들을 유지하며, 머신 목록에서 변경할 수 있습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Máy mới dùng phiên bản mặc định. Mỗi máy giữ Bundle lõi riêng, có thể đổi từ danh sách máy." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新机器使用默认版本。每台机器保留自己的核心 Bundle，可在机器列表中更改。" } }
      }
    },
    "No Core Bundle is installed. Install one in Core Bundle." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No Core Bundle is installed. Install one in Core Bundle." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コアバンドルがインストールされていません。「コアバンドル」でインストールしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "설치된 코어 번들이 없습니다. 코어 번들에서 설치하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa cài Bundle lõi nào. Hãy cài đặt trong Bundle lõi." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未安装核心 Bundle。请在“核心 Bundle”中安装。" } }
      }
    },
    "No Core Bundle version is installed. Install one in Core Bundle." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No Core Bundle version is installed. Install one in Core Bundle." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コアバンドルのバージョンがインストールされていません。「コアバンドル」でインストールしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "설치된 코어 번들 버전이 없습니다. 코어 번들에서 설치하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa cài phiên bản Bundle lõi nào. Hãy cài đặt trong Bundle lõi." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未安装任何核心 Bundle 版本。请在“核心 Bundle”中安装。" } }
      }
    },
    "Not used by any machine" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not used by any machine" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どのマシンにも使われていません" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "어떤 머신에서도 사용하지 않음" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không máy nào dùng" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有机器使用" } }
      }
    },
    "Set as Default" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Set as Default" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "デフォルトに設定" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기본값으로 설정" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đặt làm mặc định" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设为默认" } }
      }
    },
    "The Core Bundle of %@ is not installed. Choose another Core Bundle for it." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Core Bundle of %@ is not installed. Choose another Core Bundle for it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のコアバンドルがインストールされていません。別のコアバンドルを選択してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@의 코어 번들이 설치되어 있지 않습니다. 다른 코어 번들을 선택하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bundle lõi của %@ chưa được cài đặt. Hãy chọn Bundle lõi khác cho máy này." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 的核心 Bundle 未安装。请为它选择其他核心 Bundle。" } }
      }
    },
    "The boot chain is built when the machine is created. Host programs, the guest environment and guest patches can be changed later." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The boot chain is built when the machine is created. Host programs, the guest environment and guest patches can be changed later." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ブートチェーンはマシンの作成時に構築されます。ホストプログラム、ゲスト環境、ゲストのパッチは後から変更できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "부트 체인은 머신을 만들 때 빌드됩니다. 호스트 프로그램, 게스트 환경, 게스트 패치는 나중에 변경할 수 있습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chuỗi khởi động được dựng khi tạo máy. Chương trình máy chủ, môi trường máy khách và các bản vá máy khách có thể thay đổi sau." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动链在创建机器时构建。主机程序、客户机环境和客户机补丁之后仍可更改。" } }
      }
    },
    "The guest environment is from %@." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The guest environment is from %@." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲスト環境は %@ のものです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트 환경은 %@에서 가져온 것입니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Môi trường máy khách lấy từ %@." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客户机环境来自 %@。" } }
      }
    },
    "The host programs and the guest environment come from different Core Bundles. Update the guest environment to match." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The host programs and the guest environment come from different Core Bundles. Update the guest environment to match." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストプログラムとゲスト環境が異なるコアバンドルから来ています。ゲスト環境を更新して揃えてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 프로그램과 게스트 환경이 서로 다른 코어 번들에서 왔습니다. 게스트 환경을 업데이트해 맞추세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chương trình máy chủ và môi trường máy khách đến từ các Bundle lõi khác nhau. Hãy cập nhật môi trường máy khách cho khớp." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机程序与客户机环境来自不同的核心 Bundle。请更新客户机环境以保持一致。" } }
      }
    },
    "These machines use it: %@. Choose another Core Bundle for them first." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These machines use it: %@. Choose another Core Bundle for them first." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次のマシンが使用しています：%@。先に別のコアバンドルを選択してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 머신이 사용 중입니다: %@. 먼저 다른 코어 번들을 선택하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các máy sau đang dùng: %@. Hãy chọn Bundle lõi khác cho chúng trước." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下机器正在使用：%@。请先为它们选择其他核心 Bundle。" } }
