            "state" : "translated",
            "value" : "割り当て済み"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할당됨"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cấp phát"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分配"
          }
        }
      }
    },
    "Allocated on disk." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allocated on disk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク上の割り当て量です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크에 할당된 크기입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dung lượng đã cấp phát trên ổ đĩa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘上已分配的空间。"
          }
        }
      }
    },
    "Allocated on disk; deleting it frees about %@, the blocks no machine shares, once no local Time Machine snapshot keeps them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allocated on disk; deleting it frees about %@, the blocks no machine shares, once no local Time Machine snapshot keeps them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク上の割り当て量です。削除すると、どのマシンとも共有していない約 %@ が解放されます。Time Machine のローカルスナップショットが保持している場合は、その期限が切れたときに解放されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크에 할당된 크기입니다. 삭제하면 어떤 머신과도 공유하지 않는 약 %@이(가) 확보됩니다. Time Machine 로컬 스냅샷이 보관 중이면 스냅샷이 만료될 때 확보됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dung lượng đã cấp phát trên ổ đĩa; xóa sẽ giải phóng khoảng %@, phần không máy ảo nào dùng chung, sau khi không còn bản chụp nhanh cục bộ Time Machine nào giữ chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘上已分配的空间；删除约可释放 %@，即没有虚拟机共享的数据块；若 Time Machine 本地快照仍保留这些块，要等快照过期后才释放。"
          }
        }
      }
    },
    "Also deletes the AirPods pairing assets, watch faces and the language data of languages not kept, about 1.2 GB. It cannot be undone: the trim is part of the template." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also deletes the AirPods pairing assets, watch faces and the language data of languages not kept, about 1.2 GB. It cannot be undone: the trim is part of the template."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに AirPods のペアリング用アセット、文字盤、保持しない言語の言語データも削除します（約 1.2 GB）。元に戻せません。削減はテンプレートの一部です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods 페어링 에셋, 시계 페이스, 유지하지 않는 언어의 언어 데이터도 삭제합니다(약 1.2GB). 되돌릴 수 없습니다. 정리는 템플릿의 일부입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa thêm tài nguyên ghép đôi AirPods, mặt đồng hồ và dữ liệu ngôn ngữ của các ngôn ngữ không giữ lại, khoảng 1,2 GB. Không thể hoàn tác: phần cắt giảm là một phần của mẫu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还会删除 AirPods 配对资源、表盘以及未保留语言的语言数据，约 1.2 GB。此操作无法撤销：裁剪是模板的一部分。"
          }
        }
      }
    },
    "An outdated template has the key this machine needs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An outdated template has the key this machine needs."
