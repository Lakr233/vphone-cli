    "Reachable from other devices" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reachable from other devices" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ほかのデバイスからアクセス可能" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 기기에서 접근 가능" } },
