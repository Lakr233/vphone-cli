    "The clone boots as a new device. SEP storage is copied as is, so a restored machine may need restoring again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clone boots as a new device. SEP storage is copied as is, so a restored machine may need restoring again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製は新しいデバイスとして起動します。SEP ストレージはそのままコピーされるため、復元済みのマシンは再度の復元が必要になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복제본은 새로운 기기로 부팅됩니다. SEP 저장소는 그대로 복사되므로 복원된 머신은 다시 복원해야 할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nhân bản khởi động như một thiết bị mới. Bộ nhớ SEP được sao chép nguyên trạng, nên máy ảo đã khôi phục có thể cần khôi phục lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆会作为新设备启动。SEP 存储会原样拷贝，因此已恢复的虚拟机可能需要重新恢复。"
          }
        }
      }
    },
    "The clone starts as a new device. Its Secure Enclave data is copied unchanged, so you may need to restore the clone again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clone starts as a new device. Its Secure Enclave data is copied unchanged, so you may need to restore the clone again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製は新しいデバイスとして起動します。Secure Enclave のデータはそのままコピーされるため、複製を再度復元する必要がある場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복제본은 새로운 기기로 시작됩니다. Secure Enclave 데이터는 그대로 복사되므로 복제본을 다시 복원해야 할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nhân bản khởi động như một thiết bị mới. Dữ liệu Secure Enclave được sao chép nguyên trạng, nên bạn có thể cần khôi phục lại bản nhân bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆会作为新设备启动。其 Secure Enclave 数据会原样拷贝，因此你可能需要重新恢复该克隆。"
          }
        }
      }
    },
    "The command failed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The command failed."
          }
        },
        "ja" : {
