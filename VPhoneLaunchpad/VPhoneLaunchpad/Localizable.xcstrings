        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシンに必要なキーを持つテンプレートが古くなっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 머신에 필요한 키를 가진 템플릿이 오래되었습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một mẫu đã lỗi thời đang giữ khóa mà máy ảo này cần."
