    "Port Forwarding" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Port Forwarding" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ポートフォワーディング" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "포트 포워딩" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chuyển tiếp cổng" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "端口转发" } }
      }
    },
    "A forwarded port listens on this Mac only, unless it is reachable from other devices." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A forwarded port listens on this Mac only, unless it is reachable from other devices." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "転送したポートは、ほかのデバイスからのアクセスを許可しない限り、この Mac 上でのみ待ち受けます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 기기에서 접근 가능으로 설정하지 않으면 전달된 포트는 이 Mac에서만 수신합니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cổng được chuyển tiếp chỉ lắng nghe trên máy Mac này, trừ khi cho phép thiết bị khác truy cập." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转发的端口只在这台 Mac 上监听，除非允许其他设备访问。" } }
      }
    },
    "This mode cannot forward ports, so saving removes the port forwards." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This mode cannot forward ports, so saving removes the port forwards." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このモードではポートを転送できないため、保存するとポートフォワードが削除されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 모드는 포트를 전달할 수 없으므로 저장하면 포트 포워드가 제거됩니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chế độ này không chuyển tiếp cổng được, nên khi lưu các chuyển tiếp cổng sẽ bị xóa." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此模式不能转发端口，保存后会移除端口转发。" } }
      }
    },
    "Port forwarding needs NAT or Tunnel. Change the mode in Network." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Port forwarding needs NAT or Tunnel. Change the mode in Network." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ポートフォワーディングには NAT またはトンネルが必要です。モードは「ネットワーク」で変更します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "포트 포워딩에는 NAT 또는 터널이 필요합니다. 모드는 네트워크에서 변경하세요." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chuyển tiếp cổng cần NAT hoặc Đường hầm. Đổi chế độ trong Mạng." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "端口转发需要 NAT 或隧道模式，请在“网络”中更改模式。" } }
      }
    },
