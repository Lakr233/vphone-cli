// The app. Build configuration (Development or Release) comes from the
// project level; this file only names the product.

PRODUCT_NAME = vphone-launchpad
// PRODUCT_NAME has a dash, which is not a valid Swift module name.
PRODUCT_MODULE_NAME = VPhoneLaunchpad
PRODUCT_BUNDLE_IDENTIFIER = com.vphone.launchpad
// Hand-written so SMPrivilegedExecutables can carry the helper requirement.
// Outside the synchronized group: a build input, not a bundled resource.
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Resources/VPhoneLaunchpad.Info.plist
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
// VPhoneLaunchpad/AppIcon.icon, an Icon Composer document with light, dark
// and tinted appearances. actool merges CFBundleIconName into the plist.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Same languages and String Catalog setup as VPhone.bundle: English source,
// with zh-Hans, ja, ko and vi in VPhoneLaunchpad/Localizable.xcstrings.
SWIFT_EMIT_LOC_STRINGS = YES
